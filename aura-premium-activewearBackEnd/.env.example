# Neon PostgreSQL Database Configuration
# Copy this file to .env and paste your Neon connection string from https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require

# Optional: set to false only if connecting to a local Postgres instance without SSL
# DB_SSL=false

# Admin portal credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=yasas

# Express port
PORT=4000
FRONTEND_URL=http://localhost:3000

# SMTP Email Settings (Optional - logs to console if empty or missing)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aurapremium.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio SMS Config
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Security Config
JWT_SECRET=change-this-to-a-long-random-secret
